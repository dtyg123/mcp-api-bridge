# MCP ⇄ API Bridge — 环境变量示例
# 复制为 .env 后按需修改（.env 已被 git 和 docker compose 自动读取）

# 端口映射（docker compose 用）
BRIDGE_PORT=8080
LOG_LEVEL=info

# 反向代理 / 公网访问时填写，用于生成 /openapi.json 中的 servers[0].url
PUBLIC_BASE_URL=http://localhost:8080

# 三个面分别鉴权，留空 = 不鉴权
BRIDGE_REST_TOKEN=
BRIDGE_MCP_TOKEN=
# 公网部署务必设置：保护 /admin 与 /admin/api/**
BRIDGE_ADMIN_TOKEN=

# 上游 API 凭证（示例）
# RAINYUN_API_KEY=
