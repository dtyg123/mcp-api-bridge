{
  "name": "mcp-api-bridge",
  "version": "0.1.0",
  "description": "Bidirectional MCP <=> API gateway: expose MCP servers as REST/OpenAPI, and OpenAPI/Swagger services as MCP servers. Ships with a web admin UI.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openapi",
    "swagger",
    "swagger2",
    "api-gateway",
    "rest",
    "claude",
    "cursor",
    "llm",
    "ai-agents",
    "typescript",
    "docker"
  ],
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "mcp-api-bridge": "dist/src/index.js"
  },
  "engines": {
    "node": ">=20.9"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dtyg123/mcp-api-bridge.git"
  },
  "homepage": "https://github.com/dtyg123/mcp-api-bridge#readme",
  "bugs": {
    "url": "https://github.com/dtyg123/mcp-api-bridge/issues"
  },
  "author": "dtyg123",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "npm run build && node scripts/run-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^4.21.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
